{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitfarm-member",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "*.fitfarmhq.com/*",
      "zone_name": "fitfarmhq.com"
    }
  ]
}
